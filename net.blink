option ServerOutput = "src/server/net"
option ClientOutput = "src/client/net"
option FutureLibrary = "ReplicatedStorage.packages.future"

map Map<K, V> = { [K]: V }

struct JailData {
  jailed: boolean,
  timeLeft: i32,
  reason: string,
  jailedBy: string
}

struct GunFireData {
  ammo: i32,
  origin: vector,
  directions: vector[],
  timestamp: f32,
  gunType: string
}

struct BulletRenderData {
  origin: Instance,
  directions: vector[],
  position: vector,
  gunType: string,
  mode: string
}

struct SafePlayerData {
  cash: i32,
  hotbar: Map<string, string>,
  jailData: JailData
}

struct GunState {
  ammo: i32,
  mode: string,
  instance: Instance
}

struct GunModeSwitchData {
  gunType: string,
  mode: string
}

event FireGun {
  Type: Reliable,
  From: Client,
  Call: SingleAsync,
  Data: GunFireData
}

event ReloadGun {
  Type: Reliable,
  From: Client,
  Call: SingleAsync,
  Data: GunState
}

event SwitchGunMode {
  Type: Reliable,
  From: Client,
  Call: SingleAsync,
  Data: GunModeSwitchData
}

event SyncGunState {
  Type: Reliable,
  From: Server,
  Call: SingleAsync,
  Data: GunState
}

event RenderBullet {
  Type: Reliable,
  From: Server,
  Call: SingleAsync,
  Data: BulletRenderData
}

event KilledPlayer {
  Type: Reliable,
  From: Server,
  Call: SingleAsync,
  Data: string
}

event SyncPlayerData {
  Type: Reliable,
  From: Server,
  Call: SingleAsync,
  Data: SafePlayerData
}

function GetPersistentData {
  Yield: Future,
  Return: SafePlayerData
}