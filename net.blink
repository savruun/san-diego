option ServerOutput = "src/server/net"
option ClientOutput = "src/client/net"

struct GunFireData {
  ammo: i32,
  origin: vector,
  direction: vector,
  timestamp: f32,
  gunType: string
}

struct BulletRenderData {
  position: vector,
  origin: vector,
  direction: vector,
  velocity: f32
}

event FireGun {
  Type: Reliable,
  From: Client,
  Call: SingleAsync,
  Data: GunFireData
}

event RenderBullet {
  Type: Reliable,
  From: Server,
  Call: SingleAsync,
  Data: BulletRenderData
}